# Backend API base URL for the frontend (Create React App).
#
# LOCAL DEVELOPMENT: leave empty. Relative /api/v1 requests are proxied to
# http://localhost:8000 by the CRA "proxy" field in package.json — no CORS.
#
# PRODUCTION (recommended): set to your Railway backend URL, e.g.
#   REACT_APP_API_URL=https://YOUR-RAILWAY-APP.up.railway.app
# The frontend then calls the API directly (cross-origin, CORS-enabled).
#
# PRODUCTION (alternative): leave empty and rely on the Vercel /api rewrite
# in vercel.json pointing at your Railway backend.
REACT_APP_API_URL=
