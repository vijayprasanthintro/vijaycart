# Copy this file to backend/config/config.env and fill in real values.
# config.env is git-ignored and MUST NOT be committed.

PORT=8000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas in production).
DB_LOCAL_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vijaycart

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# SMTP (email) settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Vijaycart
SMTP_FROM_EMAIL=noreply@vijaycart.com

# Backend base URL used for absolute image URLs / links:
#   local:        http://127.0.0.1:8000
#   Railway:      https://YOUR-RAILWAY-APP.up.railway.app
BACKEND_URL=http://127.0.0.1:8000

# Frontend origin allowed by CORS (comma-separated for multiple domains).
#   local:        http://localhost:3000
#   Railway/Vercel: https://YOUR-FRONTEND-DOMAIN
FRONTEND_URL=http://localhost:3000

# Optional extra CORS origins (comma-separated).
# CORS_ORIGINS=https://staging.yourfrontend.com

# Logging (structured JSON lines in production).
#   LOG_LEVEL: fatal | error | warn | info | debug  (default: info)
#   LOG_PRETTY: readable multi-line output (on automatically outside production)
LOG_LEVEL=info
# LOG_PRETTY=true

# Rate limiting
#   API_RATE_LIMIT_MAX:  requests per IP per 15 min for all /api/v1 endpoints
#   AUTH_RATE_LIMIT_MAX: requests per IP per 15 min for OTP verification
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Max JSON request body size accepted (applied to json + urlencoded bodies).
JSON_BODY_LIMIT=2mb

# Extra origins allowed by the Content-Security-Policy connect-src directive
# (comma-separated). Only needed if the frontend calls the API cross-origin
# (e.g. Vercel frontend + Railway API). Defaults to same-origin only.
# CSP_CONNECT_SRC=https://api.yourbackend.com

# OTP login (passwordless mobile-first auth)
OTP_EXPIRES_MINUTES=10
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW=15
OTP_RATE_LIMIT_MAX=5

# SMS notifications (order placement + status updates).
# Set SMS_ENABLED=true once a provider is configured. To switch providers just
# change SMS_PROVIDER and fill that provider's credentials:
#   twilio   -> TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM
#   msg91    -> MSG91_AUTH_KEY / MSG91_SENDER_ID
#   fast2sms -> FAST2SMS_API_KEY / FAST2SMS_SENDER_ID
#   generic  -> SMS_GENERIC_URL + field mapping (any JSON POST gateway)
#   log      -> no provider, logs the message (dev only)
SMS_ENABLED=false
SMS_PROVIDER=log
SMS_DEFAULT_COUNTRY_CODE=91
SUPPORT_PHONE=+91 8220477466

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MSG91 (transactional route)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4
MSG91_TEMPLATE_ID=
MSG91_ENTITY_ID=
# Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_ROUTE=qt
# Generic HTTP gateway (JSON POST)
SMS_GENERIC_URL=
SMS_GENERIC_API_KEY_HEADER=
SMS_GENERIC_API_KEY=
SMS_GENERIC_PHONE_FIELD=mobile
SMS_GENERIC_MESSAGE_FIELD=message
SMS_GENERIC_SENDER_FIELD=sender_id
SMS_GENERIC_SENDER_ID=VIJAYCART
SMS_GENERIC_EXTRA_FIELDS={}

# Stripe keys (test keys shown; use live keys in production).
STRIPE_API_KEY=pk_test_XXXX
STRIPE_SECRET_KEY=sk_test_XXXX
